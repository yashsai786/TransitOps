# TransitOps Monorepo Environment Variables
# Copy these values into backend/.env and frontend/.env as needed

# Backend (.env in backend/ directory)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/transitops?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Frontend (.env in frontend/ directory)
VITE_API_BASE_URL=http://localhost:5000/api

