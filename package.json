{
  "name": "transitops",
  "version": "1.0.0",
  "description": "TransitOps - Smart Transport Operations Platform (IT645 Course Project)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "transitops",
    "fleet-management",
    "mern-stack",
    "it645"
  ],
  "author": "TransitOps Team",
  "license": "ISC"
}

